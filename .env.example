# Copy to .env and fill in. All values have safe defaults for local/mock mode.

# --- Core ---
DATABASE_URL=sqlite:///./atoac.db
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=2

# --- Razorpay (leave blank for mock mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional live LLM agents (leave blank to use deterministic templated messages) ---
# When set, negotiation lines + intent parsing are LLM-authored via Google Gemini
# (free tier — get a key at https://aistudio.google.com/app/apikey). The LLM ONLY
# phrases messages — it never decides a price or touches the guardrail.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
